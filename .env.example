# Gemini API key used by QA and document summaries.
GEMINI_API_KEY=your-gemini-api-key
# Long random secret used to sign authentication tokens.
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Hugging Face token with access to the gated IL-TUR/ILDC dataset.
HF_TOKEN=your-huggingface-token
# Optional path to the Tesseract executable; leave blank to use PATH/default.
TESSERACT_CMD=
# Retriever used by /search and /ask: bm25 (default), dense, or hybrid.
RETRIEVER=bm25
# BM25 keeps chunks scoring strictly above this value; 0 keeps every positive score.
BM25_MIN_SCORE=0
# Corpus served by /search and /ask: v1 (frozen ILDC baseline, default) or v2.
CORPUS_VERSION=v1
# v2 only: include the SCR headnote in chunks (include) or not (exclude, default).
CORPUS_HEADNOTE=exclude
