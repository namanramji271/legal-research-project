# Gemini API key used by QA and document summaries.
GEMINI_API_KEY=your-gemini-api-key
# Long random secret used to sign authentication tokens.
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Hugging Face token with access to the gated IL-TUR/ILDC dataset.
HF_TOKEN=your-huggingface-token
# Optional path to the Tesseract executable; leave blank to use PATH/default.
TESSERACT_CMD=
